{
  "id": "harbor_landing",
  "revision": "design-01",
  "title": "灯下旧埠：仓库与泊船",
  "art_direction": {
    "id": "jiangcheng_retro_electric_noir",
    "revision": "v0.2"
  },
  "intent": {
    "signature": "有厚度的暖光仓门与冷灰江面并置，沿石阶下行接近一艘低矮泊船。",
    "feeling": "雨后、安静但有人生活；熟悉旧港里有一点复古电气的新奇。",
    "invitation": "先见仓门暖光和红衣人物，靠近读清暗色岸电箱，再沿台阶走到水边回望。"
  },
  "scope": {
    "included": [
      "上层沿岸步道",
      "一间仓库",
      "下层泊船平台",
      "停泊船只与远景江面"
    ],
    "edges": [
      "两端道路以可见栏杆和堆货收束",
      "远处城市和航船只作背景",
      "本轮不包含航行、战斗、任务链或下一段湿地"
    ],
    "starting_position": "上层步道南端，面向北侧仓门和江面"
  },
  "art": {
    "composition": {
      "massing": "西侧仓库深暗长体块，东侧水面低矮开阔，台阶和泊船介于两者之间。",
      "silhouette": "梁柱与雨棚形成有节奏的直线，岸电箱和灯罩以小尺度曲线形成区别。",
      "depth": "近处绳柱和箱角，中景门口人物与船舱，远景低对岸轮廓；玩家可以走进仓库再回望江面。",
      "detail_distribution": "入口、人物与岸电设备较丰富，大墙面、地面中心与水天较安静。"
    },
    "palette": [
      {
